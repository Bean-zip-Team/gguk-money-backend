# /etc/sudoers.d/clickmoney-deploy  (0440 root:root)
#
# CI 가 비밀번호 없이 배포를 끝낼 수 있도록 필요한 명령만 허용한다.
# 설치 전 반드시 문법 검사를 통과시킬 것:
#   sudo visudo -c -f scripts/infra/clickmoney-deploy.sudoers
#
# 위협 모델: minjae 는 이미 (ALL) ALL 로 sudo 가 되지만 비밀번호가 필요하다.
# 이 파일이 정하는 건 "비밀번호 없이 접근하는 주체", 즉 GitHub Actions 배포 키가
# root 로 무엇을 할 수 있느냐다. 그래서 스크립트가 실제로 쓰는 명령만 넣는다.
#
# 의도적으로 넣지 않은 것
#   systemctl is-active *          모든 유닛에 매칭돼 범위가 지나치게 넓다.
#                                  스크립트는 sudo 없이 호출하므로 필요하지도 않다.
#   systemctl restart clickmoney   포트가 박힌 구 유닛. 실행하면 8080 바인딩에 실패한 뒤
#                                  Restart=on-failure 로 10초마다 무한 재시도한다.
#
# nginx 설정 파일 자체도 없다. 활성 포트를 담은 ~/clickmoney/nginx/upstream.conf 를
# minjae 가 소유하므로 전환할 때 root 쓰기가 필요 없다. (nginx master 는 root 로 읽는다)

minjae ALL=(root) NOPASSWD: /usr/bin/systemctl start clickmoney@*, /usr/bin/systemctl stop clickmoney@*, /usr/bin/systemctl restart clickmoney@*, /usr/bin/systemctl enable clickmoney@*, /usr/bin/systemctl disable clickmoney@*, /usr/bin/systemctl status clickmoney@*, /usr/bin/journalctl -u clickmoney@*, /usr/sbin/nginx -t, /usr/sbin/nginx -s reload
